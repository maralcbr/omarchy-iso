#!/bin/bash

if [ $# -eq 0 ]; then
  echo "Usage: omarchy-iso-upload [release/omarchy.iso]"
  exit 1
fi

if [[ ! -f ~/.config/rclone/rclone.conf ]]; then
  echo "You must first configure rclone with the R2 credentials: omarchy-iso-rclone-config"
  exit 1
fi

manifest="$1.manifest.json"
manifest_signature="$manifest.sig"
media_evidence="$1.apple-media-evidence.json"
if [[ -e $manifest || -e $manifest_signature ]]; then
  if [[ ! -f $manifest || ! -f $manifest_signature ]]; then
    echo "Refusing to publish an incomplete manifest pair: $manifest and $manifest_signature" >&2
    exit 1
  fi
  apple_artifact=0
  [[ ${1##*/} != *-apple-silicon-*.iso ]] || apple_artifact=1
  if jq -e '.target.media_target == "aarch64/apple-silicon"' "$manifest" >/dev/null 2>&1; then
    apple_artifact=1
  fi
  if (( apple_artifact )); then
    if ! jq -e '.target.media_target == "aarch64/apple-silicon"' "$manifest" >/dev/null 2>&1; then
      echo "Refusing to publish a malformed or mistargeted Apple manifest" >&2
      exit 1
    fi
    if [[ ! -f $media_evidence ]]; then
      echo "Refusing to publish an Apple manifest without its media evidence: $media_evidence" >&2
      exit 1
    fi
    if ! jq -e '
      .media_validation.boot_verified == true and
      .release_eligibility.physical_preview_gate == true and
      .release_eligibility.publication_authorized == true
    ' "$manifest" >/dev/null 2>&1; then
      echo "Refusing to publish an Apple validation artifact before boot, physical-preview, and publication gates pass" >&2
      exit 1
    fi
  fi
fi

# Every copy reports, and one failure fails the upload. Without the tally the
# last copy decides the exit status, so a signature that never made it is
# hidden by a checksum that did.
status=0

rclone copy "$1" Omarchy:omarchy/ -P || status=1

# Release sidecars are only useful when reachable beside the exact ISO. A
# manifest is optional for the legacy release path, but once either half of
# its signed pair exists the preflight above requires both before any upload.

for sidecar in "$1.sig" "$1.sha256" "$media_evidence" "$manifest" "$manifest_signature"; do
  if [[ -f $sidecar ]]; then
    rclone copy "$sidecar" Omarchy:omarchy/ -P || status=1
  fi
done

if [[ ! -f $1.sha256 ]]; then
  echo "Warning: no $1.sha256 to publish, so nobody can verify this download" >&2
fi

if [[ ! -f $manifest ]]; then
  echo "Warning: no signed release manifest to publish for $1" >&2
fi

exit $status
